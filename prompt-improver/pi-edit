}

run_claude() {
  # 모델·추론강도 = ~/.claude/settings.json 의 model·effortLevel (세션 중 /model 변경분은 알 수 없음). perl 1회로 두 줄 출력
  local smodel seffort model effort
  if [ -z "$PI_MODEL" ] || [ -z "$PI_EFFORT" ]; then
    { IFS= read -r smodel; IFS= read -r seffort; } < <(perl -MJSON::PP -e 'local $/; my $j = eval { decode_json(<STDIN>) } || {};
        print(($j->{model} // ""), "\n", ($j->{effortLevel} // ""), "\n")' < "$HOME/.claude/settings.json" 2>/dev/null)
  fi
  model=${PI_MODEL:-$smodel}; effort=${PI_EFFORT:-medium}   # 2차 effort 기본 medium (2026-10-07 결정, high 대비 wall −27%·출력 −39%·judge 동등 실측). settings 값은 PI_EFFORT 로
  { echo "<원본>"; printf '%s\n' "$orig"; echo "</원본>"; [ -n "$ctx" ] && printf '%s\n' "$ctx"; [ -n "$answers_block" ] && printf '%s\n' "$answers_block"; } > "$in"
  unset CLAUDE_CODE_CHILD_SESSION CLAUDECODE   # Claude Code 안에서 띄워도 중첩 세션 취급 안 되게
  # 사용자 지침이 있으면 합친 규칙을 임시 폴더(700) 안 파일(600)로 넘기고 끝나면 지운다(명령줄에 지침이 실리지 않게). 없으면 예전 그대로
  local sysarg=(--system-prompt "$(cat "$ins")") sdir=
  if [ -n "$custom" ]; then
    sdir=$(mktemp -d); { cat "$ins"; printf '%s' "$custom"; } > "$sdir/rules.md"; sysarg=(--system-prompt-file "$sdir/rules.md")
  fi
  run_limited "$raw" "$dir/last-run.log" claude -p ${model:+--model "$model"} ${effort:+--effort "$effort"} \
      "${sysarg[@]}" --tools "" --no-session-persistence \
      --setting-sources "" --strict-mcp-config --disable-slash-commands --output-format json
  rc=$?; stat=""
  [ -n "$sdir" ] && rm -rf "$sdir"
  if [ $rc -eq 0 ]; then
    # JSON 응답에서 본문만 꺼내 파일에, 사용량은 stat 으로. 오류 응답(is_error)·빈 본문은 실패
    stat=$(perl -MJSON::PP -e '
      local $/; my $j = eval { decode_json(<STDIN>) } or exit 1;
      exit 1 if $j->{is_error} || !length($j->{result} // "");
      open(my $o, ">", $ARGV[0]) or exit 1; binmode($o, ":utf8"); print $o $j->{result}, "\n"; close $o;
      my $u = $j->{usage} || {}; my ($m) = keys %{ $j->{modelUsage} || {} };
      printf("model=%s api_s=%.1f in=%d out=%d think=%s cost=%.4f", $m // "?", ($j->{duration_api_ms} || 0) / 1000,
        ($u->{input_tokens} || 0) + ($u->{cache_creation_input_tokens} || 0) + ($u->{cache_read_input_tokens} || 0),
        $u->{output_tokens} || 0, ($u->{output_tokens_details} || {})->{thinking_tokens} // "?", $j->{total_cost_usd} || 0)' "$out" < "$raw") || rc=1
    [ -s "$out" ] || rc=1
    [ $rc -ne 0 ] && { echo "--- raw response (is_error·오류 문구만) ---"; perl -MJSON::PP -0777 -ne 'my $j = eval { decode_json($_) }; if ($j) { printf "is_error=%s subtype=%s\n", ($j->{is_error} ? "true" : "false"), $j->{subtype} // "" } else { print substr($_, 0, 300), "\n" }' "$raw" 2>/dev/null; } >> "$dir/last-run.log"
  fi
  stat="${stat:-model=${model:-?}} effort=${effort:-settings}"
}

# post_check <결과 파일>: 모델 입력($in)에 없던 비밀 모양 문자열이 결과에 있으면 rc=143 (프롬프트 인젝션으로 읽힌 비밀이 입력창에 붙지 않게). 패턴은 imprompt_mcp.py 와 같다
post_check() {
  [ $rc -eq 0 ] || return 0
  local label; label=$(perl -0777 -e '
    open(my $s, "<:utf8", $ARGV[1]) or exit 0; my $src = <$s>; open(my $o, "<:utf8", $ARGV[0]) or exit 0; my $out = <$o>;
    my @pat = (["a private key header", qr/-----BEGIN [A-Z0-9 ]*(?:PRIVATE KEY|CERTIFICATE|PGP)[A-Z0-9 ]*-----/],
      ["an AWS key id", qr/\b(?:AKIA|ASIA)[0-9A-Z]{16}\b/], ["an SSH public key", qr/\b(?:ssh-(?:rsa|dss|ed25519)|ecdsa-sha2-nistp\d+)\s+AAAA[0-9A-Za-z+\/=]{20,}/],
      ["a GitHub token", qr/\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})/], ["an API key", qr/\bsk-[A-Za-z0-9_-]{20,}/],
      ["a Slack token", qr/\bxox[abpr]-[A-Za-z0-9-]{10,}/], ["a Google API key", qr/\bAIza[0-9A-Za-z_-]{35}\b/],
      ["a JWT", qr/\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}/]);
    for my $p (@pat) { while ($out =~ /$p->[1]/g) { if (index($src, $&) < 0) { print $p->[0]; exit 0 } } }
    while ($out =~ /[A-Za-z0-9+\/_=-]{40,}/g) {
      my $t = $&; next if index($src, $t) >= 0 || $t !~ /[A-Z]/ || $t !~ /[a-z]/ || $t !~ /\d/;
      my %c; $c{$_}++ for split //, $t; my $h = 0; $h -= $_ / length($t) * log($_ / length($t)) / log(2) for values %c;
      if ($h >= 4.3) { print "a high-entropy string"; exit 0 }
    }' "$1" "$in" 2>/dev/null)
  # 위험 새 단계: 원문(+사용자 답변)에 없던 URL·내려받아 실행·루트/홈 삭제·인코딩 PowerShell (문맥 <프로젝트>·<대화>에만 있던 것은 허용 안 함). 패턴은 imprompt_mcp.py risky_new 와 같다
  if [ -z "$label" ]; then
    local srcf; srcf=$(mktemp); printf '%s\n%s\n' "$orig" "$user_typed" > "$srcf"   # 모델이 만든 선택지(권장안)는 기준에서 뺀다 — 문맥 인젝션이 권장안에 심은 URL·명령이 Enter 한 번으로 통과하지 않게
    label=$(perl -0777 -e '
      open(my $s, "<:utf8", $ARGV[1]) or exit 0; my $src = <$s>; open(my $o, "<:utf8", $ARGV[0]) or exit 0; my $out = <$o>; my $low = lc $src;
      while ($out =~ m{\b(?:https?|ftp)://([^\s/<>"\x27`)\]]+)[^\s<>"\x27`)\]]*}gi) { my $h = lc $1; $h =~ s/[.,;:]+$//; if (index($low, $h) < 0) { print "a new URL"; exit 0 } }
      my @pat = (["a download-and-run command", qr/\b(?:curl|wget|iwr|irm|invoke-webrequest|invoke-restmethod)\b[^\n]*\|\s*(?:sudo\s+)?(?:sh|bash|zsh|iex|invoke-expression)\b/i],
        ["a recursive delete of a root or home folder", qr{\brm\s+(?:-{1,2}[A-Za-z-]+\s+)*-(?:[A-Za-z]*[rR][A-Za-z]*|-recursive)\s+(?:-{1,2}[A-Za-z-]+\s+)*(?:--\s+)?(?:/|~|\$HOME|\$\{HOME\})/?\*?(?![\w./-])}],
        ["an encoded PowerShell command", qr/\b(?:powershell|pwsh)(?:\.exe)?\b[^\n]*?\s-(?:e|ec|enc|encodedcommand)\b/i]);
      for my $p (@pat) { while ($out =~ /$p->[1]/g) { if (index($src, $&) < 0) { print $p->[0]; exit 0 } } }' "$1" "$srcf" 2>/dev/null)
    rm -f "$srcf"
  fi
  if [ -n "$label" ]; then
    rc=143; echo "--- blocked: output contained $label that was not in the request (discarded) ---" >> "$dir/last-run.log"
  fi
}

# copy_clip <파일>: 클립보드에 복사. macOS pbcopy · Windows(Git Bash) PowerShell Set-Clipboard(한글 유지) · Wayland wl-copy · X11 xclip/xsel
copy_clip() {
  if command -v pbcopy >/dev/null 2>&1; then pbcopy < "$1"
  elif command -v powershell.exe >/dev/null 2>&1; then
    powershell.exe -NoProfile -Command '[Console]::InputEncoding=[Text.Encoding]::UTF8; Set-Clipboard -Value ([Console]::In.ReadToEnd().TrimEnd())' < "$1"
  elif [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null 2>&1; then wl-copy < "$1"
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard < "$1"
  elif command -v xsel >/dev/null 2>&1; then xsel -b -i < "$1"
  else return 1; fi
}
# done_prompt <파일>: 완료 줄 "Prompt refined … c = copy"를 PI_COPY_WAIT초(기본 3, 0=끔) 띄우고 키 하나를 기다린다.
#   c·C·ㅊ(한글 자판) = 클립보드 복사, 다른 키·시간 경과 = 바로 입력창으로. 터미널이 없으면(벤치·파이프) 건너뛴다.
done_prompt() {
  local left=${PI_COPY_WAIT:-3} k more last=""; [ "$left" -gt 0 ] 2>/dev/null || return 0
  ( : < /dev/tty ) 2>/dev/null || return 0
  exec 3< /dev/tty
  local tsave; tsave=$(stty -g <&3 2>/dev/null); stty -echo <&3 2>/dev/null
  while [ "$left" -gt 0 ]; do
    [ "$left" != "$last" ] && { tty_msg "\r\033[K" "$(msg DONE "$wall" "$left")"; last=$left; }
    k=""; IFS= read -r -s -n 1 -t 1 k <&3 || { left=$((left - 1)); continue; }
    case "$k" in
      $'\xe3') IFS= read -r -s -n 2 -t 1 more <&3; k=$k$more ;;            # C 로케일이면 ㅊ(E3 85 8A)이 바이트로 나뉘어 온다
    esac
    case "$k" in
      c|C|ㅊ) local cr=ok; copy_clip "$1" || cr=none
              if [ "$cr" = ok ]; then tty_msg "\r\033[K$MSG_COPIED"; else tty_msg "\r\033[K$MSG_COPY_FAILED"; fi
              printf '%s copy %s\n' "$(date '+%F %T')" "$cr" >> "$dir/invocations.log"; sleep 0.7 ;;
    esac
    break
  done
  [ -n "$tsave" ] && stty "$tsave" <&3 2>/dev/null
  exec 3<&-
  tty_msg "\r\033[K"
}

