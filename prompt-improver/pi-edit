wait_msg "$(msg PROGRESS "$engine")" "$(msg PROGRESS_A "$engine")"
used=$engine; "run_$engine"; post_check "$out"
if [ $rc -ne 0 ] && [ "${PI_FALLBACK:-0}" = 1 ]; then        # 폴백(PI_FALLBACK=1 일 때만): 타임아웃이 아닌 실패면 다른 업체 엔진으로 1회 재시도
  other=$([ "$engine" = claude ] && echo codex || echo claude)
  if [ $rc -ne 142 ] && command -v "$other" >/dev/null 2>&1; then
    printf '%s fallback %s->%s (rc=%s)\n' "$(date '+%F %T')" "$engine" "$other" "$rc" >> "$dir/invocations.log"
    wait_msg "$(msg RETRY "$engine" "$other")" "$(msg RETRY_A "$engine" "$other")"
    used=$other; "run_$other"; post_check "$out"
  fi
fi
anim_stop
wall=$(( $(date +%s) - t0 ))
if [ $rc -eq 0 ] && [ -s "$out" ]; then
  # 붙여넣기용 정리: 모델이 본문 전체를 코드펜스로 감싼 경우만 벗긴다
  perl -0777 -i -pe 's/\A\s*```[^\n]*\n(.*?)\n```\s*\z/$1\n/s' "$out" 2>/dev/null
  cp "$out" "$f"
  rm -f "$dir/last-original.txt"   # 성공하면 원문 사본 삭제(코드 어디서도 읽지 않음 — 실패했을 때만 복구용으로 남긴다, 600)
  printf '%s ok engine=%s wall_s=%s %s ctx=%s sess=%s sid=%s chars=%s->%s%s\n' "$(date '+%F %T')" "$used" "$wall" "$stat" "${#ctx}" "$sess_how" "${CLAUDE_CODE_SESSION_ID:+1}" "${#orig}" "$(wc -m < "$out" | tr -d ' ')" "${answers_block:+ answered=1}" >> "$dir/invocations.log"
  done_prompt "$f"                                                         # 완료 줄: c = 클립보드 복사 (기록·소요초 측정 뒤라 wall 에 안 들어감)
else
  case $rc in
    142) reason=$(msg R_TIMEOUT "$timeout") ;;
    127) reason=$(msg R_NOTFOUND "$used") ;;
    143) reason=$(msg R_UNSAFE "$used") ;;
    *) reason=$(msg R_EXIT "$used" "$rc") ;;
  esac
  # 기록 줄은 예전 형식 유지 — 외부 도구가 파싱할 수 있으니 형식 유지('제한 시간'·rc= 로 실패 분류)
  if [ $rc -eq 142 ]; then lreason="제한 시간 ${timeout}s 초과"; else lreason="rc=$rc"; fi
  printf '%s FAIL engine=%s wall_s=%s %s\n' "$(date '+%F %T')" "$used" "$wall" "$lreason" >> "$dir/invocations.log"
  tty_msg "\r\033[K" "$(msg FAILED "$reason" "$dir/last-run.log")"
fi
rm -f "$out" "$raw" "$in"
exit 0
