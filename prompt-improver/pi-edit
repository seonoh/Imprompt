# 제한 시간: 백그라운드로 돌리고 감시 프로세스가 시간이 되면 끊는다 (bash 만으로 동작 — macOS·Git Bash 에 timeout 명령 없음)
run_limited() {  # run_limited <stdout파일> <stderr파일> <명령...>
  # 끝나는 즉시 반환(예전 0.2초 폴링은 호출마다 최대 0.2초 지연). 감시 프로세스가 제한 시간에 TERM → 2초 유예 뒤 KILL(SIGTERM 무시 대비), 표식 파일로 142
  local o=$1 e=$2 mark; shift 2; mark=$(mktemp)
  "$@" < "$in" > "$o" 2> "$e" & local pid=$!
  ( sleep "$timeout" && { echo t > "$mark"; pkill -P "$pid"; kill "$pid"; sleep 2; pkill -9 -P "$pid"; kill -9 "$pid"; } ) 2>/dev/null & local dog=$!   # && : 정리로 sleep 이 죽으면 표식을 쓰지 않는다
  wait "$pid"; local rc=$?
  pkill -P "$dog" 2>/dev/null; kill "$dog" 2>/dev/null; wait "$dog" 2>/dev/null   # 감시자와 그 sleep 정리(남은 프로세스 없게)
  [ -s "$mark" ] && rc=142; rm -f "$mark"; return $rc
}

run_codex() {  # 빈 임시 폴더에서 실행: 읽기 전용 샌드박스라도 프로젝트 파일을 뒤지지 않게(보안·속도)
