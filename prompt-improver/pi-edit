#!/usr/bin/env bash
# Claude Code·Codex 외부 편집기 자리에 끼우는 프롬프트 개선기: 입력창 내용을 개선해 같은 파일에 되돌려 쓴다.
# 엔진: Claude 입력창 → Claude(settings.json 모델, 2차 effort medium·1차 질문 low), Codex 입력창 → Codex(config.toml 모델·effort).
# 엔진 정책: 입력창을 연 쪽 엔진이 '주 엔진'이고 실패하면 실패 안내만 낸다 — 원문·대화 기록·프로젝트 정보가 다른 업체로 조용히 넘어가지 않게.
#   다른 업체 CLI 로의 폴백은 PI_FALLBACK=1 일 때만. 단 주 엔진이 설치돼 있지 않고 다른 쪽만 있으면 그쪽이 주 엔진이 되어 그대로 동작한다.
# 보안: codex 는 셸·이미지·웹 검색 도구를 끈다. 결과에 원문·문맥에 없던 비밀 모양 문자열(개인키 머리말·AKIA·ssh 공개키·토큰 접두·긴 고엔트로피)이 있으면 입력창에 쓰지 않고 실패 처리(rc=143).
#   터미널에 찍는 모델 출력·사용자 입력은 제어 문자(이스케이프 시퀀스)를 제거한다(tty_msg).
# 덮어쓰기: PI_ENGINE(claude|codex) PI_MODEL PI_EFFORT PI_TIMEOUT(초, 기본 90) PI_CONTEXT=0(프로젝트 인식 끄기) PI_FALLBACK=1(다른 업체 폴백 허용) PI_HISTORY=0(대화 문맥 끄기) PI_HISTORY_CHARS(턴당 글자, 기본 600)
# 사용자 지침: ~/.imprompt/custom-rules.md(IMPROMPT_HOME 이면 그 폴더, 전역 1벌·2,000자 상한)가 있으면 2차 개선 규칙 뒤에 custom-rules-wrap.md 구획으로 덧붙인다(1차 질문 ask.md 엔 안 넣음).
#   읽는 규칙은 imprompt_mcp.py custom_load/custom_block 과 같다(HTML 주석·빈 파일 무시). PI_CUSTOM=0 / IMPROMPT_CUSTOM=0 끔. 등록: imprompt_mcp.py --rules-init / --import-rules
# 게이트: 원문 앞에 `*` = 개선 없이 통과, `!` = 강제 개선. 이미 구조화된 원문·짧은 답변(입력 전체가 네/3번/1 2 1… 이고 직전 에이전트 턴이 질문)은 자동 통과(0토큰)
# 질문 모드: 모호한 요청이면(경로·식별자·수치 없음, "짧게"/brief 아님) 1차 호출(ask.md, 저강도)로 부족한 점·질문 ≤3개를 터미널에 띄우고 답(예: 1 2 1 / Enter=권장 / 자유 서술, 여러 답은 ' / ' 구분)을 받아
#   <답변>으로 2차 호출에 합친다. 기본은 선택 메뉴(ask-menu.pl: ↑↓·숫자·클릭, 질문마다 ✎ 직접 입력, Enter 다음/확정, Esc 건너뛰기), 화면이 작으면 한 줄 입력(PI_ASK_UI=line 강제).
#   한 줄 입력에선 'Waiting for answer Ns >' 짧은 줄만 매초 갱신, Esc=질문 건너뛰기, 타이핑 시작하면 시간 제한 멈춤(PI_ASK_TIMEOUT, 기본 60초).
#   터미널 입력이 안 되면 입력창에 <질문> 블록을 써 주고 답을 적은 뒤 다시 Ctrl+Q(2단 폴백). PI_ASK=0 끔, PI_ASK=always 항상 질문, PI_ASK_ANSWER='1 2 1' 자동 답(테스트)
# 화면 문구: 영어·ASCII(아래 MSG_* 한 곳, 전역 단축키 hotkey/* 와 같은 어휘). 개선 결과(모델 출력)의 언어는 그대로.
# 대기 화면: '확인 중·개선 중·재시도' 줄은 정적 문구를 먼저 쓰고, 터미널이 되면 그 자리를 연필 애니메이션(pi-anim.pl: ✎ 가 초안 ∿ 를 쓰고 다듬은 줄 ‿⁀ 로 바꾼 뒤 ✦)+경과초로 덮는다.
#   끄는 조건(정적 줄 유지): 터미널 없음·TERM=dumb·CI·UTF-8 아닌 로케일·Windows(실기기 미검증)·폭 40칸 미만. PI_ANIM=0 끔, PI_ANIM=1 강제(터미널은 필요). NO_COLOR=색만 끔
# 완료: 개선 직후 'Prompt refined (Ns). c = copy to clipboard …' 줄을 PI_COPY_WAIT초(기본 3, 0=끔) 띄움. c·ㅊ = 복사, 다른 키 = 바로 입력창.
# 기록: invocations.log 에 호출 1줄 + 결과 1줄(엔진·모델·소요초·토큰). 실패하면 원문 유지, last-run.log 에 원인.
# 이식성: bash 3.2+(macOS 기본·Git Bash) + perl(JSON::PP 코어). 규칙 파일은 이 스크립트 옆 instructions.md.
umask 077                                                     # 로그·임시파일은 본인만 읽게
dir=$HOME/.claude/prompt-improver; mkdir -p "$dir"; chmod 700 "$dir" 2>/dev/null; chmod 600 "$dir"/*.log "$dir"/last-original.txt 2>/dev/null
self=$0; [ -L "$self" ] && self=$(readlink "$self")           # 심볼릭 링크면 원본 위치
ins=$(cd "$(dirname "$self")" && pwd)/instructions.md
[ -f "$ins" ] || ins=$dir/instructions.md
ask=$(dirname "$ins")/ask.md
# 사용자 지침 블록(없거나 꺼졌으면 빈 문자열 → 아래 두 엔진 호출은 지침 도입 전과 바이트 동일). imprompt_mcp.py custom_block 과 같은 규칙 — 구획 문구는 custom-rules-wrap.md 한 곳
custom=
if [ "$PI_CUSTOM" != 0 ] && [ "$IMPROMPT_CUSTOM" != 0 ]; then
  custom=$(perl -e 'use utf8; use Encode (); binmode(STDOUT, ":utf8"); my ($cf, $wf) = @ARGV;
    open(my $f, "<:raw", $cf) or exit 0; read($f, my $raw, 65536); my $t = Encode::decode("UTF-8", $raw);
    $t =~ s/^\x{FEFF}//; $t =~ s/\r\n?/\n/g; $t =~ s/<!--.*?-->//gs; $t =~ s/<\/사용자지침>//g;
    $t =~ s/^\s+|\s+$//g; $t = substr($t, 0, 2000); $t =~ s/^\s+|\s+$//g; exit 0 unless length $t;
    open(my $w, "<:encoding(UTF-8)", $wf) or exit 0; my $tpl = do { local $/; <$w> }; $tpl =~ s/^\s+|\s+$//g;
    my $i = index($tpl, "{{RULES}}"); exit 0 if $i < 0;
    print "\n\n", substr($tpl, 0, $i), $t, substr($tpl, $i + 9)' "${IMPROMPT_HOME:-$HOME/.imprompt}/custom-rules.md" "$(dirname "$ins")/custom-rules-wrap.md" 2>/dev/null)
fi
# codex 도구 차단(프롬프트 인젝션으로 비밀 파일을 읽거나 명령을 돌리지 못하게): features.shell_tool·unified_exec·view_image 끄고 web_search="disabled".
# 출처: https://learn.chatgpt.com/docs/config-file/config-reference (features.shell_tool, web_search). -s read-only 샌드박스는 그대로 겹친다
CODEX_NOTOOLS=(--disable shell_tool --disable unified_exec --disable view_image -c 'web_search="disabled"')
# 사용자의 codex MCP 서버 전부 끄기(프롬프트 인젝션이 MCP 도구로 새는 것·재귀 방지). 전체 끄기 설정은 없고(mcp_servers={} 는 무시됨: github.com/openai/codex/issues/16045)
# 서버별 enabled=false 만 된다(https://learn.chatgpt.com/docs/config-file/config-reference). 따옴표 이름 [mcp_servers."a.b"] 은 키도 따옴표로
CODEX_MCPOFF=()
while IFS= read -r _n; do [ -n "$_n" ] && CODEX_MCPOFF+=(-c "mcp_servers.$_n.enabled=false"); done < <(perl -e '
  local $/; open(my $fh, "<:utf8", ($ENV{CODEX_HOME} || "$ENV{HOME}/.codex") . "/config.toml") or exit 0; my $t = <$fh>; binmode(STDOUT, ":utf8"); my %s;
  while ($t =~ /^\s*\[mcp_servers\.(?:([A-Za-z0-9_-]+)|"((?:[^"\\\n]|\\.)*)"|\x27([^\x27\n]*)\x27)\]\s*(?:#.*)?$/mg) {
    my $n = defined $1 ? $1 : defined $2 ? "\"$2\"" : do { (my $v = $3) =~ s/([\\"])/\\$1/g; "\"$v\"" }; $s{$n} = 1 }
  print "$_\n" for sort keys %s' 2>/dev/null)
menu=$(dirname "$ins")/ask-menu.pl                             # 질문 선택 메뉴(방향키·클릭·직접 입력). PI_ASK_UI=line 이면 한 줄 입력
anim=$(dirname "$ins")/pi-anim.pl                              # 대기 줄 도트 애니메이션
f=$1
# invocations.log 순환: 1MB 넘으면 .1 로 교체(옛 것 1개만 보관). 형식은 그대로 — 외부 도구가 파싱할 수 있으니 형식 유지
sz=$(wc -c < "$dir/invocations.log" 2>/dev/null); [ "${sz:-0}" -gt 1048576 ] 2>/dev/null && mv -f "$dir/invocations.log" "$dir/invocations.log.1"
printf '%s args=%s\n' "$(date '+%F %T')" "$*" >> "$dir/invocations.log"
[ -f "$f" ] || exit 0
# 입력창 임시파일이 아니면(git commit 등) 일반 편집기로 넘긴다. Claude 는 파일 이름만 본다(폴더 이름에 claude-prompt- 가 들어간 저장소의 COMMIT_EDITMSG 를 보내지 않게),
# Codex 는 ~/.codex/editor/ 아래. Windows 경로(역슬래시)도 매치
fb=${f##*/}; fb=${fb##*\\}
if [ "${fb#claude-prompt-}" != "$fb" ]; then engine=${PI_ENGINE:-claude}
else
  case "$f" in
    *.codex/editor/*|*.codex\\editor\\*) engine=${PI_ENGINE:-codex} ;;
    *) [ -n "${PI_EDIT_PASSED:-}" ] && exec vi "$@"                    # 다른 이름의 링크·래퍼로 다시 이 스크립트가 불리면 재귀 대신 vi
       export PI_EDIT_PASSED=1; set -f                                # EDITOR 값의 * ? 가 현재 폴더 파일로 펼쳐지지 않게
       for e in "${PI_NEXT_EDITOR:-}" "${EDITOR:-}" vim vi; do          # 프롬프트가 아닌 파일은 사용자의 편집기로(VISUAL 은 이 스크립트)
         case "$e" in ''|*/pi-edit|pi-edit|*/pi-edit\ *|pi-edit\ *) continue ;; esac
         command -v "${e%% *}" >/dev/null 2>&1 && exec $e "$@"
       done; echo "pi-edit: no editor found (set EDITOR)" >&2; exit 1 ;;
  esac
fi
export IMPROMPT_CHILD=1   # 이 스크립트가 띄우는 엔진(claude·codex) 전부에 전달 — 엔진 안의 imprompt MCP 서버가 도구를 노출하지 않게(재귀 방지)
# 주 엔진 미설치 + 다른 쪽만 설치 = 그쪽이 주 엔진(폴백이 아님 — 그 사용자에겐 그것뿐이므로). 둘 다 없으면 그대로 두어 아래에서 'CLI not found'
if ! command -v "$engine" >/dev/null 2>&1; then
  alt=$([ "$engine" = claude ] && echo codex || echo claude)
  if command -v "$alt" >/dev/null 2>&1; then
    printf '%s primary-switch %s->%s (not installed)\n' "$(date '+%F %T')" "$engine" "$alt" >> "$dir/invocations.log"; engine=$alt
  fi
fi
# 터미널 출력. $1 = 고정 이스케이프(%b: \r \033[K 등), $2 = 동적 글자(모델 출력·사용자 입력·엔진 이름 — %s 로 찍고 제어 문자 제거), $3 = 고정 꼬리(%b)
# 제거 대상 = \000-\010 \013-\037 \177 + UTF-8 로 인코딩된 C1(U+0080-9F). 바이트 \x80-\x9f 를 그냥 지우면 한글이 깨지므로 C1 은 선행 바이트 \xC2 와 함께만 지운다.
# 터미널 이스케이프 주입(모델이 낸 질문·선택지·사용자 답으로 화면을 지우거나 제목·클립보드를 바꾸는 시퀀스) 방어. 터미널이 없으면(테스트·파이프) 조용히 무시
san() { printf '%s' "$1" | LC_ALL=C perl -pe 's/\xc2[\x80-\x9f]//g; s/[\x00-\x08\x0b-\x1f\x7f]//g'; }
tty_msg() {
  local t=$2; case "$t" in ""|*[!A-Za-z0-9\ ._/:-]*) [ -n "$t" ] && t=$(san "$t") ;; esac
  { printf '%b' "$1"; printf '%s' "$t"; printf '%b' "$3"; } > /dev/tty
} 2>/dev/null
# 사용자에게 보이는 상태 문구(한 곳). 전역 단축키(hotkey/*)와 같은 어휘, Windows(Git Bash) 콘솔 때문에 ASCII 만.
# %s 자리는 msg 로 채운다: msg <이름> [값…]. 개선 결과(모델 출력)의 언어는 바꾸지 않는다.
MSG_CHECKING="Checking for missing details... (%s, 5-10s)"           ; MSG_CHECKING_A="Checking for missing details | %s | 5-10s"
MSG_CHECKING_HIST="Details missing: reading recent conversation... (%s, 5-10s)"; MSG_CHECKING_HIST_A="Reading recent conversation | %s | 5-10s"
MSG_PROGRESS="Refining prompt... (%s, 10-30s)"                         ; MSG_PROGRESS_A="Refining prompt | %s | 10-30s"
MSG_RETRY="%s failed. Retrying with %s..."                             ; MSG_RETRY_A="%s failed | retrying with %s"
MSG_DONE="Prompt refined (%ss). c = copy to clipboard, any other key = back to input (%s)"
MSG_COPIED="Refined prompt copied to clipboard."
MSG_COPY_FAILED="Copy failed: no clipboard tool found (pbcopy, wl-copy, xclip)."
MSG_FAILED="Refinement failed: %s. Original text kept. Log: %s"
MSG_R_TIMEOUT="timed out after %ss"
MSG_R_EXIT="%s returned an error (exit code %s)"
MSG_R_NOTFOUND="%s CLI not found (install it or check PATH)"
MSG_R_UNSAFE="%s output blocked (secret or risky text that was not in your request)"
MSG_ASK_KEYS="Enter = accept all recommended, Esc = skip questions, typing pauses the timer"
MSG_ASK_WAIT="Waiting for answer %ss > "
MSG_ASK_TYPING="Answer > "
MSG_ASK_LINE_HINT="(Answer examples: 1 2 1 | free text | separate answers with ' / ')"
MSG_ASK_SKIPPED="Questions skipped. Refining without answers."
MSG_ASK_TIMEOUT="No input for %ss. Using recommended answers."
MSG_ASK_ANSWER="Answer: %s"
MSG_ASK_ALL_REC="all recommended"
MSG_ASK_BAD_OPT="Question %s: no option [%s]. Using recommended."
msg() { local f; eval "f=\$MSG_$1"; shift; printf -- "$f" "$@"; }

# 대기 애니메이션 켤 조건(ora is-interactive·OMC 비대화형 판정 차용): 터미널 쓰기 가능·TERM≠dumb·CI 아님·UTF-8 로케일(연필·물결 글리프)·Windows 아님
anim_ok() {
  [ -n "$anim_on" ] && { [ "$anim_on" = 1 ]; return; }
  anim_on=0
  [ "${PI_ANIM:-auto}" = 0 ] || [ ! -f "$anim" ] && return 1
  ( : > /dev/tty ) 2>/dev/null || return 1
  if [ "${PI_ANIM:-auto}" != 1 ]; then
    case "${TERM:-dumb}" in dumb|unknown) return 1 ;; esac
    [ -n "$CI$GITHUB_ACTIONS" ] && return 1
    case "${LC_ALL:-${LC_CTYPE:-$LANG}}" in *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) ;; *) return 1 ;; esac
    case "$OSTYPE" in msys*|cygwin*) return 1 ;; esac
  fi
  anim_on=1
}
# wait_msg <정적 문구> <애니메이션 문구>: 정적 줄을 먼저 쓰고(폴백), 조건이 되면 같은 자리를 연필 애니메이션으로 덮는다(폭이 좁으면 렌더러가 그리지 않아 정적 줄 유지)
wait_msg() {
  anim_stop; tty_msg "\r\033[K" "$1"
  anim_ok && { perl "$anim" "$2" < /dev/null > /dev/null 2>&1 & anim_pid=$!; }
}
# anim_stop: 렌더러에 TERM → 줄 지우고 커서 복원 후 곧바로 종료(실측 ~1ms)하니 바로 기다린다. 감시 프로세스가 1초 안에 안 끝나면 KILL(대기가 멈추지 않게)
anim_stop() {
  [ -n "$anim_pid" ] || return 0
  kill "$anim_pid" 2>/dev/null
  ( sleep 1; kill -9 "$anim_pid" 2>/dev/null ) 2>/dev/null & local dog=$!; disown "$dog" 2>/dev/null   # disown: 종료 알림 줄이 화면에 안 찍히게
  wait "$anim_pid" 2>/dev/null; [ $? -ge 128 ] && tty_msg "\r\033[K\033[?25h"   # 신호로 강제 종료됐으면 커서만 복원(폭 부족 등 스스로 끝난 경우는 정적 줄 유지)
  kill "$dog" 2>/dev/null; anim_pid=""
}
anim_pid=""; anim_on=""; out=""; raw=""; in=""
trap 'anim_stop; [ -n "$in" ] && rm -f "$out" "$raw" "$in"' EXIT; trap 'exit 130' INT TERM HUP   # 신호로 끊겨도 원문·문맥이 든 임시 파일을 지운다

# build_answers <질문줄들> <답 줄> → <답변> 블록. 답은 ' / ' 로 나누거나(자유 서술 포함) 공백으로 나눈 번호. ' / ' 없이 글자가 섞이면 통째로 1번 질문의 자유 서술. 비면 1번(권장).
build_answers() {
  local qs=$1 a=$2; [ -n "$qs" ] || return
  local sep=" / "; case "$a" in */*) ;; *[!0-9\ -]*) ;; *) sep=" " ;; esac   # 번호·공백·- 만이면 공백 구분, 글자가 섞이면 통째로 한 답(1번 질문) — 자유 서술이 단어별로 쪼개지지 않게
  printf '<답변>\n'
  local i=0 q
  while IFS= read -r q; do
    [ -n "$q" ] || continue; i=$((i + 1))
    local tok; tok=$(printf '%s' "$a" | awk -v n="$i" -v s="$sep" 'BEGIN{FS=s} {gsub(/^[ \t]+|[ \t]+$/, "", $n); print $n}')
    local qt; qt=$(printf '%s' "$q" | sed -E 's/^[0-9]\)[[:space:]]*//; s/[[:space:]]*\[1\].*$//')
    local choice
    if [ -z "$tok" ] || [ "$tok" = "-" ]; then tok=1; fi
    case "$tok" in
      ✎*) choice=${tok#✎}; choice=${choice# } ;;                         # 메뉴의 직접 입력(숫자만이어도 글자 그대로)
      [0-9]) choice=$(printf '%s' "$q" | sed -nE "s/.*\[$tok\][[:space:]]*([^[]*).*/\1/p" | sed -E 's/[[:space:]]+$//')
             if [ -z "$choice" ]; then                                       # 선택지에 없는 번호(0·9 등) → 권장
               tty_msg "\r\033[K" "$(msg ASK_BAD_OPT "$i" "$tok")" "\n"
               choice=$(printf '%s' "$q" | sed -nE 's/.*\[1\][[:space:]]*([^[]*).*/\1/p' | sed -E 's/[[:space:]]+$//'); choice=${choice:-선택지 1}
             fi ;;
      *) choice=$tok ;;
    esac
    printf -- '- %s → %s\n' "$qt" "$choice"
  done <<EOF_Q
$qs
EOF_Q
  printf '</답변>\n'
}

# read_answer: fd 3(터미널)에서 한 글자씩 읽는다. 결과 ans·ans_how(enter|skip|timeout). 시간 PI_ASK_TIMEOUT(기본 60초)
#   안내(Enter=권장·Esc=건너뛰기)는 한 번만 출력하고, 매초 다시 그리는 건 짧은 줄 "Waiting for answer Ns >"(≈25칸)뿐 — 좁은 창에서 줄이 접혀 화면이 밀리지 않게.
#   글자를 치기 시작하면 시간 제한을 멈추고 더는 다시 그리지 않는다(입력한 글자만 덧붙임). Enter=확정(비었으면 전부 권장) · Esc=질문 건너뛰기 · Backspace=지우기
read_answer() {
  local left=${PI_ASK_TIMEOUT:-60} buf="" c nx rc idle=0 typing=0 last=""
  ans=""; ans_how=timeout
  local tsave; tsave=$(stty -g <&3 2>/dev/null); stty -echo <&3 2>/dev/null   # 읽기 사이에 친 키(Esc 등)가 ^[ 로 찍히지 않게 대기 내내 에코 끔
  tty_msg "$MSG_ASK_KEYS\n"
  while :; do
    if [ "$typing" = 0 ] && [ "$left" != "$last" ]; then tty_msg "\r\033[K" "$(msg ASK_WAIT "$left")"; last=$left; fi
    IFS= read -r -s -n 1 -t 1 c <&3; rc=$?
    if [ $rc -ne 0 ]; then                                                # 1초 무입력 (bash 3.2 는 시간 초과도 rc=1 → EOF 와 같이 처리)
      if [ "$typing" = 1 ]; then idle=$((idle + 1)); [ "$idle" -ge 600 ] && { ans=$buf; ans_how=enter; break; }; continue; fi   # 입력 중엔 멈춤(10분 상한)
      left=$((left - 1)); [ "$left" -le 0 ] && { ans=""; ans_how=timeout; break; }
      continue
    fi
    idle=0
    case "$c" in
      ""|$'\004') ans=$buf; ans_how=enter; break ;;                        # Enter·Ctrl+D
      $'\e') IFS= read -r -s -n 1 -t 1 nx <&3                             # 방향키(ESC [ X)는 무시, 단독 Esc 는 건너뛰기
              if [ "$nx" = "[" ] || [ "$nx" = "O" ]; then IFS= read -r -s -n 1 -t 1 nx <&3; continue; fi
              ans=""; ans_how=skip; break ;;
      $'\177'|$'\b') [ -z "$buf" ] && continue
              local ch=${buf#"${buf%?}"}; buf=${buf%?}
              case "$ch" in [[:print:]]) [ "$(printf '%s' "$ch" | LC_ALL=C wc -c | tr -d ' ')" -gt 1 ] && tty_msg "\b\b  \b\b" || tty_msg "\b \b" ;; *) tty_msg "\b\b  \b\b" ;; esac ;;
      *) if [ "$typing" = 0 ]; then typing=1; tty_msg "\r\033[K$MSG_ASK_TYPING"; fi
         buf=$buf$c; tty_msg "" "$c" ;;
    esac
  done
  [ -n "$tsave" ] && stty "$tsave" <&3 2>/dev/null
  case "$ans_how" in
    skip) tty_msg "\r\033[K$MSG_ASK_SKIPPED\n" ;;
    timeout) tty_msg "\r\033[K" "$(msg ASK_TIMEOUT "${PI_ASK_TIMEOUT:-60}")" "\n" ;;
    *) tty_msg "\r\033[K" "$(msg ASK_ANSWER "${ans:-$MSG_ASK_ALL_REC}")" "\n" ;;
  esac
}
# ask_query <문구 이름>: 1차 호출(ask.md, 저강도) 한 번 → 전역 qtext. 문구 이름은 MSG_<이름>(정적)·MSG_<이름>_A(애니메이션)
ask_query() {
  wait_msg "$(msg "$1" "$engine")" "$(msg "$1_A" "$engine")"
  { cat "$ask"; echo; echo "<원본>"; printf '%s\n' "$orig"; echo "</원본>"; [ -n "$ctx" ] && printf '%s\n' "$ctx"; } > "$in"
  local qraw; qraw=$(mktemp)
  if [ "$engine" = codex ]; then
    local empty; empty=$(mktemp -d)
    run_limited /dev/null "$dir/last-ask.log" codex exec --skip-git-repo-check -s read-only --ephemeral -C "$empty" \
      "${CODEX_NOTOOLS[@]}" "${CODEX_MCPOFF[@]}" -c project_doc_max_bytes=0 -c 'model_reasoning_effort="low"' -o "$qraw" - ; rmdir "$empty" 2>/dev/null
  else
    { echo "<원본>"; printf '%s\n' "$orig"; echo "</원본>"; [ -n "$ctx" ] && printf '%s\n' "$ctx"; } > "$in"
    local jr; jr=$(mktemp)
    run_limited "$jr" "$dir/last-ask.log" claude -p ${PI_MODEL:+--model "$PI_MODEL"} --effort low \
      --system-prompt "$(cat "$ask")" --tools "" --no-session-persistence --setting-sources "" --strict-mcp-config --disable-slash-commands --output-format json
    perl -MJSON::PP -e 'local $/; my $j = eval { decode_json(<STDIN>) } or exit 1; exit 1 if $j->{is_error}; binmode(STDOUT, ":utf8"); print $j->{result} // ""' < "$jr" > "$qraw" 2>/dev/null
    stat_ask=$(perl -MJSON::PP -e 'local $/; my $j = eval { decode_json(<STDIN>) } or exit 0; my $u = $j->{usage} || {}; printf("ask_api_s=%.1f ask_out=%d", ($j->{duration_api_ms} || 0) / 1000, $u->{output_tokens} || 0)' < "$jr" 2>/dev/null)
    rm -f "$jr"
  fi
  anim_stop                                                              # 메뉴·한 줄 입력·폴백 블록 전에 애니메이션 정리
  qtext=$(sed -E 's/\r$//' "$qraw" | sed '/./,$!d'); rm -f "$qraw"
}
# hist_late: 선택 텍스트(원문)+프로젝트 정보만으로 부족할 때(1차가 질문을 냄) 대화 기록을 늦게라도 붙인다.
#   처음엔 짧은 요청·지시어일 때만 붙이므로(토큰 절약) 그 밖의 요청은 여기서 한 번 더 기회. 붙였으면 0(→ 1차 재확인), 기록 없음·생략 판정이면 1
hist_late() {
  [ "${PI_HISTORY:-1}" = 0 ] || [ "$sess_how" != none ] && return 1
  local h how; h=$(session_ctx force 2>/dev/null)
  how=$(printf '%s\n' "$h" | sed -n 's/^@@SESS@@ //p')
  h=$(printf '%s\n' "$h" | grep -v '^@@\(SESS\|TAIL\)@@')
  [ -n "$how" ] && sess_how=late-$how
  [ -n "$h" ] || return 1
  ctx="$ctx
$h"
}
# ask_user: 1차 호출로 질문을 받아 터미널에서 답을 묻고 <답변> 블록을 answers_block 에 넣는다. 터미널 입력 불가면 2단 폴백(입력창에 <질문> 블록) 후 종료.
ask_user() {
  local mode=${PI_ASK:-1}; [ "$mode" = 0 ] && return 0
  [ -n "$answers_block" ] && return 0                                   # 이미 2단 폴백으로 답을 받음
  if [ "$mode" != always ]; then
    # "짧게"/"brief" 요청은 빠르고 짧게: 질문 단계 없이 바로 2차(미정은 [가정]·[확인 필요] ≤1)
    if printf '%s' "$orig" | grep -qiE '^[[:space:]]*(짧게|brief)'; then return 0; fi
    # 명확 판정(0토큰): 경로·식별자(camelCase·snake_case·--옵션)·재현 절차가 있으면 묻지 않는다 (OMC keyword-detector · MoAI skip 차용)
    if printf '%s' "$orig" | grep -qE '[a-z][a-z0-9]*_[a-z0-9_]+|(^|[[:space:]])--[a-z][a-z-]+|[A-Za-z0-9_./-]+\.(ts|tsx|js|jsx|py|go|rs|java|kt|swift|rb|php|cs|sh|md|json|yaml|yml|toml|sql|css|html)\b|(^|[[:space:]/])(src|lib|app|apps|packages|tests?)/|#[0-9]+\b|재현|reproduce|Traceback|Error:|[a-z]+[A-Z][a-zA-Z]+\(' ; then return 0; fi
    # 수치·단위는 변경 동사와 함께일 때만 명확("30초로 늘려줘"), 단독이면 묻는다("5개 언어 지원 추가")
    if printf '%s' "$orig" | grep -qE '[0-9]+[[:space:]]?(px|ms|초|분|건|개|%|MB|KB)' && printf '%s' "$orig" | grep -qE '늘려|줄여|바꿔|변경|설정|맞춰|올려|낮춰|increase|decrease|set |change'; then return 0; fi
  fi
  ask_query CHECKING
  local qlines; qlines=$(printf '%s\n' "$qtext" | grep -E '^[0-9]\)' | head -3)          # 질문은 최대 3개(ask.md 규칙 강제)
  # 문맥 보강: 부족한 점이 나왔는데 대화 기록을 아직 안 붙였으면 붙여서 한 번 더 확인(기록으로 풀리면 질문 없이 진행, 2차에도 기록이 들어감)
  if [ -n "$qlines" ] && ! printf '%s\n' "$qtext" | grep -q '^[[:space:]]*READY' && hist_late; then
    local stat1=$stat_ask; ask_query CHECKING_HIST; stat_ask="$stat1 hist=late $stat_ask"
    qlines=$(printf '%s\n' "$qtext" | grep -E '^[0-9]\)' | head -3)
  fi
  if [ -z "$qlines" ] || printf '%s\n' "$qtext" | grep -q '^[[:space:]]*READY'; then return 0; fi   # 명확(READY 는 어느 줄이든) → 질문 없이 2차
  local shown; shown=$(printf '%s\n' "$qtext" | grep -m1 '^부족한 점'; printf '%s\n' "$qlines")
  local ans="" ans_how=enter
  if [ -n "${PI_ASK_ANSWER+x}" ]; then ans=$PI_ASK_ANSWER                        # 테스트·벤치용 자동 답
  elif ( : < /dev/tty ) 2>/dev/null; then                                  # 터미널 입력 가능할 때만 (exec 실패로 셸이 죽지 않게 서브셸로 먼저 확인)
    local mo="" mrc=1
    if [ "${PI_ASK_UI:-menu}" != line ] && [ -f "$menu" ]; then           # 선택 메뉴(대체 화면): ↑↓·숫자·클릭 선택, 질문마다 ✎ 직접 입력
      mo=$(PI_MENU_Q="$qlines" PI_MENU_HDR="$(printf '%s\n' "$qtext" | grep -m1 '^부족한 점')" perl "$menu" 2>/dev/null); mrc=$?
    fi
    if [ $mrc -eq 5 ]; then                                               # 메뉴 중 터미널이 닫힘 → 더 쓰지 않고 원문 유지로 끝
      printf '%s ask-eof questions=%s %s\n' "$(date '+%F %T')" "$(printf '%s\n' "$qlines" | grep -c .)" "$stat_ask" >> "$dir/invocations.log"
      rm -f "$out" "$raw" "$in"; exit 0
    fi
    if [ $mrc -eq 0 ]; then
      ans_how=$(printf '%s\n' "$mo" | sed -n 1p); ans=$(printf '%s\n' "$mo" | sed -n 2p)
      case "$ans_how" in
        skip) tty_msg "\r\033[K$MSG_ASK_SKIPPED\n" ;;
        timeout) tty_msg "\r\033[K" "$(msg ASK_TIMEOUT "${PI_ASK_TIMEOUT:-60}")" "\n" ;;
        *) tty_msg "\r\033[K" "$(msg ASK_ANSWER "$(printf '%s\n' "$mo" | sed -n 3p)")" "\n" ;;
      esac
    else                                                                   # 메뉴 불가(화면 작음·perl 실패) → 한 줄 입력
      exec 3< /dev/tty
      tty_msg "\r\033[K\n" "${shown}" "\n$MSG_ASK_LINE_HINT\n"
      read_answer                                                          # 응답 대기 표시·남은 초·Enter=권장·Esc=건너뛰기
      exec 3<&-
    fi
    tty_msg "\r\033[K" "$(msg PROGRESS "$engine")"
  else
    # 2단 폴백: 입력창에 질문 블록을 써 주고 종료. 사용자가 "답:" 줄을 채우고 다시 Ctrl+Q
    # 질문 글도 모델 출력이다 — 원문에 없던 URL·내려받아 실행·비밀 모양이 있으면 입력창에 쓰지 않고 질문 없이 2차로(문맥 인젝션이 질문에 심은 명령을 그대로 보내지 않게)
    local qf rc0=${rc:-0}; qf=$(mktemp); printf '%s\n' "$shown" > "$qf"; rc=0; post_check "$qf"; local qblocked=$rc; rc=$rc0; rm -f "$qf"
    if [ "$qblocked" = 143 ]; then
      printf '%s ask-fallback-blocked questions=%s %s\n' "$(date '+%F %T')" "$(printf '%s\n' "$qlines" | grep -c .)" "$stat_ask" >> "$dir/invocations.log"
      return 0
    fi
    { echo "<질문>"; printf '%s\n' "$shown"; echo "답: "; echo "</질문>"; printf '%s\n' "${forced:+!}$orig"; } > "$f"   # 강제 개선(!)이었으면 재호출 때도 유지
    printf '%s ask-fallback questions=%s %s\n' "$(date '+%F %T')" "$(printf '%s\n' "$qlines" | grep -c .)" "$stat_ask" >> "$dir/invocations.log"
    rm -f "$out" "$raw" "$in"; exit 0
  fi
  user_typed=$ans                                                     # 사용자가 실제로 친 답(번호·직접 입력) — 위험 검사의 '사용자가 준 것' 기준(모델 선택지 문구는 넣지 않는다)
  local alog=${ans:-<권장>}; [ "$ans_how" = timeout ] && alog="<권장·시간초과>"
  case "$alog" in "<권장>"|"<권장·시간초과>") ;; *[!0-9\ /]*) alog="<직접 입력 ${#alog}자>" ;; esac    # 직접 입력한 답은 내용 대신 글자 수만(기록에 사용자 문장을 남기지 않는다)
  if [ "$ans_how" = skip ]; then answers_block=""; alog="<건너뜀>"            # 질문 없이 진행: 2차가 미정 사항을 [확인 필요]로 남긴다
  else answers_block=$(build_answers "$qlines" "$ans"); fi
  printf '%s ask questions=%s answer=%s %s\n' "$(date '+%F %T')" "$(printf '%s\n' "$qlines" | grep -c .)" "$alog" "$stat_ask" >> "$dir/invocations.log"
}
orig=$(cat "$f")
[ -z "$(printf '%s' "$orig" | tr -d '[:space:]')" ] && exit 0

# 2단 폴백 복귀: 입력창에 이전 Ctrl+Q 가 써 둔 <질문> 블록이 있으면 "답:" 줄을 읽어 <답변>으로 쓰고 블록은 원본에서 뺀다
answers_block=""; user_typed=""
if printf '%s' "$orig" | grep -q '^<질문>' && printf '%s' "$orig" | grep -q '^</질문>'; then
  qblock=$(printf '%s\n' "$orig" | sed -n '/^<질문>/,/^<\/질문>/p' | sed '1d;$d')
  ans_line=$(printf '%s\n' "$qblock" | sed -nE 's/^답:[[:space:]]*//p' | head -1)
  qlines=$(printf '%s\n' "$qblock" | grep -E '^[0-9]\)' )
  orig=$(printf '%s\n' "$orig" | sed '/^<질문>/,/^<\/질문>/d' | sed '/./,$!d')
  answers_block=$(build_answers "$qlines" "$ans_line"); user_typed=$ans_line
fi

# 결정론 게이트(0토큰, OMC ralplan·OMX triage 차용): `*` 접두 = 그대로 통과, `!` 접두 = 강제 개선.
skip_reason=""; forced=""
case "$orig" in
  \*\**) ;;                                                           # '**굵게**' 로 시작하는 글은 통과 표식이 아니다(첫 * 를 지우지 않는다)
  \**) printf '%s' "${orig#\*}" | sed '1s/^[[:space:]]*//' > "$f"; skip_reason="별표 접두(강제 통과)" ;;
  \!*) forced=1; orig=${orig#\!}; orig=${orig#"${orig%%[![:space:]]*}"} ;;
esac
# 프로젝트 인식(가볍게 ~100토큰): 세션 폴더의 최상위 항목 + 스택 단서. 모델이 스택·경로를 추측하지 않고 실제 사실을 쓰게 한다
project_ctx() {
  [ "${PI_CONTEXT:-1}" = 0 ] && return
  local root top markers
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=$PWD
  top=$(ls -1A "$root" 2>/dev/null | grep -vE '^(\.git|\.DS_Store|node_modules|\.omc|\.omx)$' | head -40 | tr '\n' ' ')
  # 항목 6개 이하 폴더는 내용도 한 줄로(폴더 이름만 보고 스택을 짐작하지 않게 — 예: web/ 이 단일 HTML). 상한 420자(≈100토큰)
  local sub="" d n
  for d in $(cd "$root" && ls -1d */ 2>/dev/null | grep -vE '^(node_modules|\.)' | head -12); do
    n=$(ls -1 "$root/$d" 2>/dev/null | grep -c .); [ "$n" -ge 1 ] && [ "$n" -le 6 ] || continue
    sub="$sub$d: $(cd "$root/$d" && ls -1p 2>/dev/null | tr '\n' ' ')· "
  done
  sub=$(printf '%s' "$sub" | cut -c1-420)
  markers=$(cd "$root" && ls -1 package.json pnpm-lock.yaml yarn.lock tsconfig.json next.config.* vite.config.* pyproject.toml requirements.txt setup.py go.mod Cargo.toml pom.xml build.gradle* Gemfile composer.json Package.swift pubspec.yaml Dockerfile docker-compose.* Makefile CLAUDE.md AGENTS.md 2>/dev/null | tr '\n' ' ')
  [ -z "$top" ] && return
  [ -n "$sub" ] && sub="하위: ${sub% · }"$'\n'
  printf '<프로젝트>\n폴더: %s\n최상위: %s\n%s스택 단서: %s\n</프로젝트>\n' "$(basename "$root")" "$top" "$sub" "${markers:-없음}"
}
# 대화 문맥(가볍게): 원본이 짧거나 지시어(그것·아까·이어서…)를 담은 후속 요청일 때, 또는 1차 확인에서 부족한 점이 나왔을 때(hist_late, session_ctx force)
#   현재 세션 기록의 마지막 텍스트 턴 2개(각 ≤PI_HISTORY_CHARS, 기본 600자)를 <대화>로 동봉. 끄기 PI_HISTORY=0
# Claude: CLAUDE_CODE_SESSION_ID 가 있으면 ~/.claude/projects/<cwd 인코딩>/<ID>.jsonl 만(세션 고정, 파일이 없으면 생략). 없으면 가장 최근 jsonl, 단 10분 안에 갱신된 세션이 2개 이상이면 생략(오인보다 누락이 안전).
# Codex: ~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl 최근 40개 중 1줄째(session_meta)의 cwd 가 현재 폴더이고 thread_source 가 user 인 것(서브에이전트·가디언 세션 제외). 10분 안에 갱신된 후보가 2개 이상이면 생략.
# 출력 끝에 내부 줄 "@@SESS@@ id|noid|recent|ambig|none"(어떻게 골랐나, 로그용)·"@@TAIL@@ …"(마지막 에이전트 턴 끝 200자, 짧은 답변 게이트용)을 붙인다.
session_ctx() {
  [ "${PI_HISTORY:-1}" = 0 ] && return
  local words; words=$(printf '%s' "$orig" | wc -w | tr -d ' ')
  if [ "$1" != force ] && [ "$words" -gt 15 ] && ! printf '%s' "$orig" | grep -qE '그것|그거|그걸|아까|이어서|방금|위에|이전|그 다음|다시|also|that one|same as'; then return; fi
  local sf="" how=recent
  if [ "$engine" = claude ]; then
    local pdir; pdir=$HOME/.claude/projects/$(printf '%s' "$PWD" | sed 's#[/.]#-#g')
    if [ -n "$CLAUDE_CODE_SESSION_ID" ]; then                           # ID 가 있으면 그 파일만. 이 폴더에 없으면 다른 jsonl 은 전부 남의 세션 → 생략
      [ -f "$pdir/$CLAUDE_CODE_SESSION_ID.jsonl" ] || { echo "@@SESS@@ noid"; return; }
      sf=$pdir/$CLAUDE_CODE_SESSION_ID.jsonl; how=id
    elif [ "$(find "$pdir" -maxdepth 1 -name '*.jsonl' -mmin -10 2>/dev/null | grep -c .)" -ge 2 ]; then echo "@@SESS@@ ambig"; return
    else sf=$(ls -t "$pdir"/*.jsonl 2>/dev/null | head -1); fi
  else
    local f cwdw IFS=$'\n'; cwdw=$(pwd -W 2>/dev/null | sed 's#/#\\\\#g')   # Git Bash 면 Windows 경로(C:\\…, JSON 이스케이프)로도 대조
    for f in $(ls -t "$HOME"/.codex/sessions/*/*/*/*.jsonl 2>/dev/null | head -40); do
      head -1 "$f" | grep -q '"thread_source":"user"' || continue
      if head -1 "$f" | grep -qF "\"cwd\":\"$PWD\"" || { [ -n "$cwdw" ] && head -1 "$f" | grep -qF "\"cwd\":\"$cwdw\""; }; then
        if [ -z "$sf" ]; then sf=$f; else [ -n "$(find "$f" -mmin -10 2>/dev/null)" ] && { echo "@@SESS@@ ambig"; return; }; break; fi
      fi
    done
  fi
  [ -n "$sf" ] || return
  echo "@@SESS@@ $how"
  PI_SESS_FMT=$engine perl -MJSON::PP -e '
    use utf8; binmode(STDOUT, ":utf8"); my $lim = $ENV{PI_HISTORY_CHARS} || 600; my $codex = ($ENV{PI_SESS_FMT} // "") eq "codex"; my (%last, %ord);
    # 파일 끝에서 256KB 만 먼저 읽고, 두 역할을 다 못 찾았을 때만 3MB 로 넓힌다(긴 세션 15MB 기준 0.5s → 수십 ms). 첫 줄은 잘린 줄이라 버림
    open(my $fh, "<:raw", $ARGV[0]) or exit 0; my $size = -s $fh; my @lines;
    for my $want (262144, 3000000) {
      my $n = $want < $size ? $want : $size; seek($fh, $size - $n, 0); read($fh, my $buf, $n);
      @lines = split /\n/, $buf; shift @lines if $n < $size;
      %last = (); %ord = ();
    for (my $i = $#lines; $i >= 0 && keys(%last) < 2; $i--) {
      my ($r, $x) = ("", "");
      if ($codex) {                                                      # Codex rollout: response_item/message 의 role + input_text/output_text
        next unless $lines[$i] =~ /"type":"response_item"/ && $lines[$i] =~ /"role":"(user|assistant)"/;
        my $j = eval { decode_json($lines[$i]) } or next; my $p = $j->{payload}; next unless ref $p eq "HASH" && ($p->{type} // "") eq "message";
        $r = $p->{role} // ""; next unless $r =~ /^(user|assistant)$/ && !exists $last{$r};
        $x = join "\n", map { $_->{text} // "" } grep { ref $_ eq "HASH" && ($_->{type} // "") =~ /^(input|output)_text$/ } @{$p->{content} || []};
        $x =~ s/^\s+|\s+$//g; next if $x eq "" || $x =~ /^(<|#\s*AGENTS\.md instructions)/;   # 주입된 AGENTS.md·<environment_context> 등 블록만 제외 (# 제목으로 시작하는 실제 요청은 유지)
      } else {                                                           # Claude Code jsonl: type user/assistant 의 message.content
        next unless $lines[$i] =~ /"type":"(user|assistant)"/ && !exists $last{$1}; $r = $1;
        my $j = eval { decode_json($lines[$i]) } or next; next if $j->{isMeta};
        my $c = $j->{message}{content};
        if (ref $c eq "ARRAY") { $x = join "\n", map { $_->{text} // "" } grep { ref $_ eq "HASH" && ($_->{type} // "") eq "text" } @$c } else { $x = $c // "" }
        $x =~ s/^\s+|\s+$//g; next if $x eq "" || $x =~ /^</;          # 도구 결과·시스템 블록 제외
      }
      $last{$r} = $x; $ord{$r} = $i }
      last if keys(%last) == 2 || $n >= $size;
    }
    exit 0 unless %last;
    if (exists $last{assistant}) { my $t = $last{assistant}; $t =~ s/\s+/ /g; print "\@\@TAIL\@\@ ", substr($t, -200), "\n" }
    print "<대화>\n";
    for my $r (sort { $ord{$a} <=> $ord{$b} } keys %last) { my $x = $last{$r}; $x = substr($x, 0, $lim) . "…" if length($x) > $lim; $x =~ s/\n+/ /g; print(($r eq "user" ? "사용자: " : "에이전트: "), $x, "\n") }
    print "</대화>\n"' "$sf"
}
