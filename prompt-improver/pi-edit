  # 대화 기록이 있으면 직전 에이전트 턴이 질문으로 끝났을 때만 억제(OMX triage suppress_followup 차용), 기록이 없으면 답변 어휘만으로 억제
  elif printf '%s' "$orig" | tr '\n' ' ' | grep -qiE '^[[:space:]]*(네|예|응|넵|넹|ㅇㅇ|ㄱㄱ|아니|아뇨|ok|okay|yes|no|y|n|그래|좋아|진행|계속|그거|그것|이거|이걸로|그걸로|[0-9]번?|[0-9]([[:space:]]+[0-9])*)([[:space:]]*[.,!~]*[[:space:]]*(해|해줘|해주세요|please|go|계속|진행|그걸로|좋아))*[[:space:]]*[.,!~]*[[:space:]]*$'; then
    if [ -z "$agent_tail" ] || printf '%s' "$agent_tail" | grep -qE '\?|할까요|하실래요|드릴까요|괜찮을까요|선택|고르|골라|원하시면|알려주세요|말씀해'; then skip_reason="짧은 답변(후속 억제)"; fi
